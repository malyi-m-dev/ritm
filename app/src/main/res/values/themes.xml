<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Ritm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ritm_background</item>
        <item name="android:statusBarColor">@color/ritm_surface</item>
        <item name="android:navigationBarColor">@color/ritm_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Ritm.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ritm_foreground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ritm</item>
    </style>

</resources>
